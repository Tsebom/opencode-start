{
  "$schema": "https://opencode.ai/config.json",
  "provider": {
    "wormsoft": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "My Custom Provider",
      "options": {
        "baseURL": "https://ai.wormsoft.ru/api/gpt",
        "apiKey": "{env:WORMSOFT_API_KEY}" // Ключ хранится в отдельном файле
      },
      "models": {
        "wormsoft/mine/onlycode": {
          "name": "OnlyCode"
        }
      }
    },
    "polza": {
      "npm": "@ai-sdk/openai-compatible",
      "options": {
        "baseURL": "https://polza.ai/api/v1",
        "apiKey": "{env:POLZA_API_KEY}" // Ключ хранится в отдельном файле
      },
      "models": {
        "minimax/minimax-m3": {
          "name": "PolzaCode"
        }
      }
    }
  }
}
